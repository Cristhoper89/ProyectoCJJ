{
  "expo": {
    "name": "La Cabaña",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B2C12",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cristhoper89.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear el código QR de la mesa.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar una imagen para la carta."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      "./plugins/with-android-gradle-memory",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D1A17",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
